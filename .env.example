# Copy to .env (gitignored). Placeholders only; never commit real values.
# Host-side (api/worker run on the host in dev): use localhost addresses.
KAFKA_BOOTSTRAP=localhost:19092
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=CHANGE_ME

# LLM (provider-agnostic; model IDs are never hardcoded, take them from the provider docs)
LLM_PROVIDER=template            # template | openai | anthropic | sarvam (anthropic and sarvam: adapters not built yet)
LLM_MODEL=CHANGE_ME              # for example the current balanced model from your provider
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
SARVAM_API_KEY=
# optional per-role overrides (empty = use LLM_PROVIDER and LLM_MODEL)
AGENT_LLM_PROVIDER=
AGENT_LLM_MODEL=
BASELINE_LLM_PROVIDER=
BASELINE_LLM_MODEL=
FIX_LLM_PROVIDER=
FIX_LLM_MODEL=
LLM_REASONING_EFFORT=low         # none | low | medium | high (reasoning models)
LLM_MAX_OUTPUT_TOKENS=4000
LLM_CACHE_MODE=off               # off | record | replay (recordings live in ./.llm-cache, git-ignored)

AUTO_INVESTIGATE=true
SIM_SPEED_DEFAULT=10
SIM_WARMUP_SPEED=200
RUN_WORKER_IN_API=true

FIX_BACKEND=codex_cli            # codex_cli | llm_tool_loop (auto-fallback if CLI unavailable)
FIX_CACHE_MODE=off               # off | record | replay
PR_ADAPTER=local                 # local | github
GITHUB_TOKEN=
GITHUB_REPO=owner/name
DEMO_REPO_PATH=./.demo-repos/payment-service
SANDBOX_DIR=./.sandboxes
